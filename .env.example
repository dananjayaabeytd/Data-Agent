OPENAI_API_KEY=replace-with-your-key
# Model profile from config/models.yaml: budget (gpt-5-nano) or quality (gpt-5.6, for demos).
# Leave empty to use the `active` profile in that file.
MODEL_PROFILE=
DATA_AGENT_API_KEY=replace-with-a-long-random-api-key
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=data-agent
JWT_AUDIENCE=data-agent-api
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOWED_HOSTS=127.0.0.1,localhost
ETL_ALLOWED_HOSTS=
ETL_MAX_DOWNLOAD_BYTES=26214400
ETL_MAX_INPUT_BYTES=52428800
ETL_MAX_OUTPUT_BYTES=52428800
AGENT_MAX_CONCURRENCY=4
SESSION_BACKEND=sqlite
SESSION_MAX_MESSAGES=100
host=localhost
port=5432
database=postgres
user=postgres
password=postgres
db_readonly_user=data_agent_reader
db_readonly_password=replace-with-a-different-password
# Create or update the read-only role at startup (default true outside production)
DB_MANAGE_READONLY_ROLE=true
DB_INCLUDE_SAMPLES=false
# Database setup at API startup (seeding defaults to true in development, false in production)
DB_MIGRATE_ON_STARTUP=true
DB_SEED_ON_STARTUP=true
LOG_LEVEL=INFO

# Langfuse tracing and evaluation (tracing is off when the keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Fraction of requests to trace (1.0 = all)
LANGFUSE_SAMPLE_RATE=1.0